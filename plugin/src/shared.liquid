{% template main %}
{% unless image.image_url %}
<div class="layout layout--col layout--center">
  <span class="description">{{ notice | default: "No picture available right now. The next refresh tries again." }}</span>
</div>
{% else %}
<svg width="0" height="0" style="position:absolute"><filter id="potd-sharpen"><feConvolveMatrix order="3" preserveAlpha="true" kernelMatrix="0 -0.6 0 -0.6 3.4 -0.6 0 -0.6 0"/></filter></svg>
{% if v_compact and h_compact %}
<div class="layout gap--none" style="padding:0">
  <img src="{{ image.image_url }}" class="image image-dither" style="width:100%;height:100%;object-fit:cover;filter:url(#potd-sharpen) contrast(1.35) brightness(1.04)" alt="{{ image.title | escape }}" />
</div>
{% elsif h_compact %}
<div class="layout layout--col gap--none" style="padding:0;align-items:stretch">
  <img src="{{ image.image_url }}" class="image image-dither" style="width:100%;flex:1 1 auto;min-height:0;object-fit:cover;filter:url(#potd-sharpen) contrast(1.35) brightness(1.04)" alt="{{ image.title | escape }}" />
  <div style="padding:10px 12px 0">
    <span class="title title--small" data-clamp="2">{{ image.title | escape }}</span>
    <span class="label label--small" data-clamp="1">{{ image.credit | escape }}</span>
  </div>
</div>
{% else %}
<div class="layout gap--none" style="padding:0;align-items:stretch">
  <img src="{{ image.image_url }}" class="image image-dither" style="width:{% if v_compact %}58%{% else %}64%{% endif %};height:100%;object-fit:cover;filter:url(#potd-sharpen) contrast(1.35) brightness(1.04)" alt="{{ image.title | escape }}" />
  <div style="flex:1;display:flex;flex-direction:column;padding:{% if v_compact %}10px 14px{% else %}16px 20px 14px{% endif %};min-width:0;border-left:3px solid #000">
    <div style="display:flex;justify-content:space-between;align-items:baseline;border-bottom:2px solid #000;padding-bottom:5px">
      <span class="label label--small" style="text-transform:uppercase;letter-spacing:1.5px;font-weight:700">Picture of the day</span>
      {% if image.date_label != blank %}<span class="label label--small">{{ image.date_label }}</span>{% endif %}
    </div>
    {% comment %} lines the title takes in the side column (about 26 characters a line), and the description lines left under it {% endcomment %}
    {% assign tl = image.title.size | divided_by: 26 | plus: 1 %}{% if v_compact %}{% if tl > 2 %}{% assign tl = 2 %}{% endif %}{% assign dl = tl | times: 22 | minus: 150 | times: -1 | divided_by: 14 %}{% else %}{% if tl > 4 %}{% assign tl = 4 %}{% endif %}{% assign dl = tl | times: 22 | minus: 370 | times: -1 | divided_by: 15 %}{% endif %}{% if dl < 1 %}{% assign dl = 1 %}{% endif %}
    <span class="title title--small" style="margin-top:12px;line-height:1.2" data-clamp="{{ tl }}">{{ image.title | escape }}</span>
    {% if image.description != blank %}
    <span class="description" style="margin-top:10px;line-height:1.35" data-clamp="{{ dl }}">{{ image.description | escape }}</span>
    {% endif %}
    <div style="margin-top:auto;padding-top:8px;border-top:1px solid #000;display:flex;justify-content:space-between;align-items:center;gap:8px">
      <span class="label label--small" style="min-width:0" data-clamp="2">{{ image.credit | escape }}</span>
      {% unless v_compact %}<span class="label label--small" style="background:#000;color:#fff;padding:2px 8px;border-radius:10px;white-space:nowrap">{{ image.position }}</span>{% endunless %}
    </div>
  </div>
</div>
{% endif %}
{% endunless %}
{% endtemplate %}
